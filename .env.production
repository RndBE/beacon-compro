# Public values for production builds (`npm run build` / `npm run deploy`).
# They are inlined into the client JS, so they are not secrets. Server secrets
# live only in /var/www/vhosts/be-jogja.com/app/.env on server3.
PUBLIC_API_BASE=https://admin.be-jogja.com/api/v1
PUBLIC_STORAGE_BASE=https://admin.be-jogja.com
