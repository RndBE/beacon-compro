# be-jogja.com on server3 — installed at /etc/systemd/system/beacon-prod.service.
# Runs the compiled SvelteKit app only: no source, no node_modules (all deps are
# bundled into build/). Releases are shipped by scripts/deploy.sh into
# app/releases/<stamp>-<sha>, and app/current points at the live one.
[Unit]
Description=be-jogja.com (beacon-compro, SvelteKit adapter-node, 127.0.0.1:4173)
After=network-online.target
Wants=network-online.target

[Service]
User=be-jogja.com_irhvuw5z3o
Group=psacln
WorkingDirectory=/var/www/vhosts/be-jogja.com/app/current
Environment=HOST=127.0.0.1 PORT=4173
# .env holds the runtime secrets; it is read once at start, so edits need a restart.
ExecStart=/opt/plesk/node/24/bin/node --env-file=/var/www/vhosts/be-jogja.com/app/.env build/index.js
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
